# Environment Variables for AEGIS SOC Forensic Platform
# For Vercel Deployment: Configure these in your Vercel Project Settings -> Environment Variables

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/soc_platform?retryWrites=true&w=majority

# JWT Signing Secret (must be at least 32 characters long for OWASP compliance)
JWT_SECRET=soc_forensic_platform_super_secret_jwt_key_2026_at_least_32_chars!

# Environment
NODE_ENV=production

# (Optional) Authorized client origin for CORS if using a custom domain
# CLIENT_ORIGIN=https://your-custom-domain.com
